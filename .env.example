# Tunables for the synthetic producer (docker/producer). Copy to `.env` next
# to docker/docker-compose.yml and run `docker compose --env-file ../.env up`,
# or export these directly before `docker compose up`.
#
# Rate is per topic — the producer writes to all three topics (orders.json,
# orders.avro, logs.text) every tick, so actual total throughput is 3x these
# numbers.

# Steady-state rate outside a burst window.
RATE_MSGS_PER_SEC=5

# Periodic burst window, meant to stress-test phase 3's ring buffer/throttle.
BURST_ENABLED=true
BURST_RATE_MSGS_PER_SEC=200
BURST_INTERVAL_MS=60000
BURST_DURATION_MS=5000
