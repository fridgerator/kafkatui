# Tunables for the synthetic producer (docker/producer). Copy to `.env` next
# to docker/docker-compose.yml and run `docker compose --env-file ../.env up`,
# or export these directly before `docker compose up`.
#
# Rate is per topic — the producer writes to orders.json, orders.avro and
# logs.text every tick, so actual total throughput is 3x these numbers.
# orders.large is separate, on its own slow cadence (see below).

# Steady-state rate outside a burst window.
RATE_MSGS_PER_SEC=5

# Periodic burst window, meant to stress-test phase 3's ring buffer/throttle.
BURST_ENABLED=true
BURST_RATE_MSGS_PER_SEC=200
BURST_INTERVAL_MS=60000
BURST_DURATION_MS=5000

# Dedicated large-payload topic (orders.large) — big nested JSON, to see how the
# TUI renders multi-hundred-KB messages. Keep under ~900000 unless you also raise
# the broker/producer/consumer 1 MB size limits.
LARGE_PAYLOAD_BYTES=300000
LARGE_INTERVAL_MS=3000
